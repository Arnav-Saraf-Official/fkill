{
  "name": "fkill",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",		"build": "vite build",
		"build:static": "node scripts/build.mjs static",
		"build:vercel": "node scripts/build.mjs vercel",
		"build:cloudflare": "node scripts/build.mjs cloudflare",
		"build:node": "node scripts/build.mjs node",
		"preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",		"relay": "npm run build:relay && node server/relay.mjs",
		"relay:smoke": "node scripts/relay-smoke.mjs",
		"build:relay": "node scripts/build-relay.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/adapter-vercel": "^7.0.1",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
