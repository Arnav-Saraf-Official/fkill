# Public WebSocket endpoint of the authoritative relay. Baked into the client
# at build time, so rebuild after changing it.
# Local default (when unset) is ws://localhost:8787/ws.
VITE_FKILL_RELAY_URL=ws://localhost:8787/ws

# The relay reads these at runtime (not from this file):
# PORT=8787
# FKILL_ALLOWED_ORIGIN=https://your-frontend.example.com
