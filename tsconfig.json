{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "tests", "vite.config.ts", "vitest.config.ts"],
	"exclude": ["server/dist", "build", ".svelte-kit"]
}
